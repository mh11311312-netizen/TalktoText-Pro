# ============================================================
#  TalkToText Pro  —  Environment variables
#  1. Copy this file and rename the copy to  ".env"
#  2. Paste your real values below
#  3. NEVER share your .env file or commit it to GitHub
# ============================================================

# --- Your OpenAI API key (required) ---
# Get it from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# --- OpenAI model used for notes/chat (you can leave this as is) ---
OPENAI_MODEL=gpt-4o-mini

# --- MongoDB connection string (optional) ---
# If you have MongoDB Atlas (free), paste its connection string here.
# If you leave this empty, the app automatically uses a local JSON
# file (data_store.json) so it still works without MongoDB.
MONGO_URI=

# Database name inside MongoDB
MONGO_DB=talktotext

# --- AssemblyAI key (OPTIONAL) ---
# Only needed for the "speaker diarization" feature (who spoke how much).
# Get a free key from: https://www.assemblyai.com/
# If you leave this empty, the app uses Whisper (works great, no speaker labels).
ASSEMBLYAI_API_KEY=

# --- Flask session secret (any random long text) ---
SECRET_KEY=change-this-to-any-random-long-string-123456

# --- (Optional) SMTP settings, only needed if you want to actually
#     SEND emails instead of just drafting them. Leave empty to skip. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
